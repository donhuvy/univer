{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BKIT Office",
  "version": "1.0.0",
  "identifier": "com.bkit.office",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BKIT Office - BKIT.VN",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "BKIT.VN",
    "copyright": "Copyright © 2026 BKIT.VN. All rights reserved.",
    "shortDescription": "Bộ ứng dụng văn phòng doanh nghiệp tích hợp 4-trong-1: Bảng tính, Soạn thảo văn bản, Trình chiếu và Ký số/Chỉnh sửa PDF.",
    "longDescription": "BKIT Office là bộ ứng dụng văn phòng toàn diện, chuyên nghiệp dành cho doanh nghiệp, phát triển và phân phối thương mại bởi BKIT.VN dựa trên lõi Univer (Apache 2.0)."
  }
}
